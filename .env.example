EVALUATION_PROTOCOL_CONTAINER_NAME=evaluation-protocol
EVALUATION_PROTOCOL_BACKEND_CONTAINER_NAME=evaluation-protocol-api
EVALUATION_PROTOCOL_POSTGRES_CONTAINER_NAME=evaluation-protocol-postgres

POSTGRES_VERSION=16-alpine
POSTGRES_DB='$your-postgres-db-name'
POSTGRES_USER='$your-postgres-user'
POSTGRES_PASSWORD='$your-postgres-password'

SESSION_COOKIE_NAME=s1
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_MINUTES=360
SESSION_CLEANUP_INTERVAL_MINUTES=60

MICROSOFT_TENANT_ID='$your-microsoft-entra-tenant-id'
MICROSOFT_CLIENT_ID='$your-microsoft-entra-app-id'
MICROSOFT_CLIENT_SECRET='$your-microsoft-client-secret-key'
MICROSOFT_REDIRECT_PATH=/api/v1/auth/callback/microsoft
MICROSOFT_SCOPES=["openid","email","User.Read"]

INITIALIZATION_EMAIL='$your-bootstrap-admin-email:admin@example.com'
COMPANY_EMAIL_DOMAIN='$your-company-email-domain:example.com'
FRONTEND_SUCCESS_URL=/
FRONTEND_FAILURE_URL=/login
VITE_LOGIN_EYEBROW=Evaluation Protocol
